# clinixospro.com — Cloudflare Pages custom headers
# Goal: edge-cache STATIC ASSETS aggressively, but never cache HTML.
# 2026-11-04: the previous assumption ("Pages purges the edge cache on every
# production deploy, so long s-maxage values are safe") was WRONG. A deploy
# reached the origin but the edge kept serving the 2h-old HTML at "/" for
# ~2 hours: the live root had removed upsells/countdown while every
# cache-busted URL had them gone. Visitors saw the stale page. HTML is now
# edge-cached for 60s only. Assets keep their long TTLs.

/
  Cache-Control: public, max-age=60, s-maxage=60, must-revalidate
/*.html
  Cache-Control: public, max-age=60, s-maxage=60, must-revalidate
/blog/*
  Cache-Control: public, max-age=60, s-maxage=60, must-revalidate
/logiciel-cabinet-medical-hors-ligne/*
  Cache-Control: public, max-age=60, s-maxage=60, must-revalidate
/img/*
  Cache-Control: public, max-age=14400, s-maxage=31536000, must-revalidate
/fonts/*
  Cache-Control: public, max-age=14400, s-maxage=31536000, must-revalidate
/styles.css
  Cache-Control: public, max-age=3600, s-maxage=31536000, must-revalidate
/locations.js
  Cache-Control: public, max-age=3600, s-maxage=31536000, must-revalidate
