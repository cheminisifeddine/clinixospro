# clinixospro.com — Cloudflare Pages custom headers
# HTML must never be cached by the browser: a 4-hour browser cache was
# serving the old countdown/upsell version to mobile visitors after deploys.
# Assets keep long TTLs; the HTML is always revalidated.

/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Surrogate-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store
  Surrogate-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/blog/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/logiciel-cabinet-medical-hors-ligne/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/img/*
  Cache-Control: public, max-age=14400, s-maxage=31536000, must-revalidate

/fonts/*
  Cache-Control: public, max-age=14400, s-maxage=31536000, must-revalidate

/styles.css
  Cache-Control: public, max-age=3600, s-maxage=31536000, must-revalidate

/locations.js
  Cache-Control: public, max-age=3600, s-maxage=31536000, must-revalidate
